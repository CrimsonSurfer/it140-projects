# Project One Get-Item Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: get-item and inventory design for M7 Project Two
#
# Review the course-provided get-item flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, SET, ADD, or similar terms.

START get_item

  RECEIVE requested_item, current_room, and inventory
  FROM the main loop, which prompts for and reads "get item name"

  REMOVE leading and trailing spaces from requested_item
  CONVERT requested_item TO lowercase

  IF requested_item IS empty
      OUTPUT "Enter an item name after get."

  ELSE IF requested_item matches an item in inventory,
        ignoring capitalization
      OUTPUT "You already have that item."

  ELSE IF current_room contains an item
        SET room_item TO the item in current_room
        IF requested_item matches room_item, ignoring capitalization
            ADD room_item TO inventory
            REMOVE room_item from current_room
            OUTPUT "You collected " + room_item
            OUTPUT inventory
        ELSE
            OUTPUT "That item is not in this room."
        END IF

  ELSE
        OUTPUT "There is no item to collect in this room."
  END IF

  RETURN inventory TO the main loop

END get_item

